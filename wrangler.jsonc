{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "azkena",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-18",
  // `global_fetch_strictly_public` is required by @cloudflare/workers-oauth-provider
  // so it may fetch Client ID Metadata Documents (CIMD) from arbitrary public URLs
  // during dynamic client registration / token exchange.
  "compatibility_flags": ["nodejs_compat_v2", "global_fetch_strictly_public"],
  // Default vars for `wrangler dev` (no --env flag).
  // Staging/production override these below.
  "vars": {
    "ENVIRONMENT": "development",
    "FRONTIS_URL": "https://frontis-gateway.pilotariak.com/graphql",
    "LOG_LEVEL": "debug"
  },
  // OAuth 2.0 authorization server storage. REQUIRED for the `/oauth/*` endpoints.
  // Create the namespace once, then fill in the IDs produced by:
  //   bunx wrangler kv namespace create OAUTH_KV
  //   bunx wrangler kv namespace create OAUTH_KV --preview
  // The `/oauth/authorize` consent screen will return 404 until this binding
  // exists (the provider has no storage without it).
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "0bdfcadf4fc94bc39d09daf8e8e81302"
    }
  ],
  "env": {
    "staging": {
      "name": "azkena-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "FRONTIS_URL": "https://frontis-gateway.pilotariak.com/graphql",
        "LOG_LEVEL": "debug"
      }
    },
    "production": {
      "name": "azkena",
      "routes": [
        {
          "pattern": "mcp.pilotariak.com/*",
          "custom_domain": true
        }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "FRONTIS_URL": "https://frontis-gateway.pilotariak.com/graphql",
        "LOG_LEVEL": "info"
      }
    }
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
