{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "azkena",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-18",
  // `global_fetch_strictly_public` is required by @cloudflare/workers-oauth-provider
  // so it may fetch Client ID Metadata Documents (CIMD) from arbitrary public URLs
  // during dynamic client registration / token exchange.
  "compatibility_flags": ["nodejs_compat_v2", "global_fetch_strictly_public"],
  // Default vars for `wrangler dev` (no --env flag).
  // Staging/production override these below.
  "vars": {
    "ENVIRONMENT": "development",
    "FRONTIS_URL": "https://frontis-gateway.pilotariak.com/graphql",
    "LOG_LEVEL": "debug"
  },
  // OAuth 2.0 authorization server storage. REQUIRED for the `/oauth/*` endpoints.
  // Create the namespace once, then fill in the IDs produced by:
  //   bunx wrangler kv namespace create OAUTH_KV
  //   bunx wrangler kv namespace create OAUTH_KV --preview
  // The `/oauth/authorize` consent screen will return 404 until this binding
  // exists (the provider has no storage without it).
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "0bdfcadf4fc94bc39d09daf8e8e81302"
    }
  ],
  // Native Cloudflare Rate Limiting binding (not the WAF "Rate Limiting Rules"
  // product). 60 requests / 60s per client IP, enforced per Cloudflare colo
  // (best-effort, not billing-grade). `period` only accepts 10 or 60.
  // Bindings are NOT inherited by named environments, so this is redeclared
  // under env.staging / env.production below, each with its own namespace_id
  // so counters aren't shared across environments.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "env": {
    "staging": {
      "name": "azkena-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "FRONTIS_URL": "https://frontis-gateway.pilotariak.com/graphql",
        "LOG_LEVEL": "debug"
      },
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 60, "period": 60 }
        }
      ]
    },
    "production": {
      "name": "azkena",
      "routes": [
        {
          "pattern": "mcp.pilotariak.com/*",
          "custom_domain": true
        }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "FRONTIS_URL": "https://frontis-gateway.pilotariak.com/graphql",
        "LOG_LEVEL": "info"
      },
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "1003",
          "simple": { "limit": 60, "period": 60 }
        }
      ]
    }
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
